# Copy to .env and fill in. Never commit .env.

# Discord
DISCORD_TOKEN=
OWNER_ID=                # Your Discord user ID (owner-only commands like /model)

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Ollama-Tools API (search, weather, time, geo, crypto)
TOOLS_API_HOST=http://localhost:3100

# Optional: scheduled-notifications service (/webhook)
WEBHOOK_API_HOST=http://localhost:3200

# Optional: GIF search for Answer Machine (Klipy)
KLIPY_API_KEY=
